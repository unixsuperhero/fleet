{
  "name": "fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --locked --bin bindings",
    "bindings:check": "cargo run --manifest-path src-tauri/Cargo.toml --locked --bin bindings -- --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run bindings && npm run typecheck && vite build",
    "tauri": "tauri",
    "check": "bash scripts/check.sh",
    "build:local": "bash scripts/build-local.sh",
    "build:smoke": "bash scripts/build-local.sh --debug"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.11.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
