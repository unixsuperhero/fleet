{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only Fleet's local main webview may operate its enrolled hosts and terminals. Native dialogs and URL opening stay behind app commands.",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-list-hosts",
    "allow-save-host",
    "allow-delete-host",
    "allow-discover",
    "allow-allocate-connection",
    "allow-connect",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-terminal-disconnect",
    "allow-answer-challenge",
    "allow-acknowledge-output",
    "allow-list-sessions",
    "allow-check-session",
    "allow-choose-backup-directory",
    "allow-export-backup",
    "allow-choose-restore",
    "allow-commit-restore",
    "allow-cancel-restore",
    "allow-diagnostics-preview",
    "allow-export-diagnostics",
    "allow-open-link",
    "allow-choose-setup-checkout",
    "allow-prepare-host-setup"
  ]
}
